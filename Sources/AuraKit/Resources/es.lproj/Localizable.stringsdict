<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's one grammatical plural: the moon sheet's "en N días" relative-day tail. Spanish base. -->
<plist version="1.0">
<dict>
    <key>rel.inDays</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>en %d día</string>
            <key>other</key>
            <string>en %d días</string>
        </dict>
    </dict>
</dict>
</plist>
