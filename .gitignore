# macOS
.DS_Store

# Swift Package Manager
/.build/
/Packages/
.swiftpm/

# Xcode (app targets land in later phases)
xcuserdata/
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Local specs (per Projects convention: specs/ is local-only)
specs/

# Local-only docs: internal notes and submission material kept off GitHub but on disk
docs/local/

# Secrets — the AEMET key never enters the repo
.env
*.pem

# Obsidian workspace
.obsidian/

# Python bytecode
__pycache__/

# Hero-art generation workspace — hundreds of MB of regenerable renders; the shipped art already
# lives in the asset catalogs (Aura/Assets + AuraWidgets/Assets).
hero_asset_creation/

# Generated screenshots — regenerable via scripts/, and the App Store copies live in App Store Connect.
screenshots/
